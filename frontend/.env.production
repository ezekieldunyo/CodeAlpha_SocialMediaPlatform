# Used by `npm run build` (production builds) instead of .env.
#
# VITE_API_URL is the base URL of the PHP API, fixed into the built files.
# On the live site the React app and the API share one domain (the API is the
# /api folder next to index.html), so a path is enough and the same build
# works on any domain. Only use a full URL (https://example.com/api) if the
# API is hosted somewhere else.
VITE_API_URL=/api
